# This local edition runs entirely on your machine with a free, open-source
# LLM served by Ollama (https://ollama.com) — no API key and no per-request
# cost. See README.md for setup.

# OLLAMA_HOST: where the local Ollama server is listening.
OLLAMA_HOST="http://127.0.0.1:11434"

# OLLAMA_MODEL: which pulled Ollama model to use for text/JSON generation.
# Any instruction-tuned model works. qwen2.5:3b is the default because it runs
# well on modest laptops (CPU-only, 16 GB RAM) and handles tool calling.
# On a machine with a capable GPU, a larger model (e.g. qwen2.5:7b) is fine.
# Pull it first with: ollama pull qwen2.5:3b
OLLAMA_MODEL="qwen2.5:3b"

# OLLAMA_KEEP_ALIVE: how long Ollama keeps the model loaded in memory between
# requests, avoiding reload latency on every AI action.
OLLAMA_KEEP_ALIVE="30m"

# WHISPER_MODEL: local, free speech-to-text model (downloaded once, then
# cached offline) used for voice-debrief transcription.
WHISPER_MODEL="Xenova/whisper-base"

# PORT: local port for the app server.
PORT="3000"
